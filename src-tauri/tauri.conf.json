{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geoventure Launcher",
  "version": "2.0.0-rust.1",
  "identifier": "fr.geoventure.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Geoventure Launcher",
        "width": 1200,
        "height": 740,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://www.youtube-nocookie.com",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Geoventure",
    "shortDescription": "Launcher Geoventure",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGOEJEODJEMjNGMDNCNzEKUldSeE8vQWpMZGlMdnpYVU9NZWFIUStCWTliQk5PYXZGZldFWnVYSXNzR1h5ZUJSVDRjdkYwcDkK",
      "endpoints": [
        "https://github.com/Geoventure-MC/Launcher-v3/releases/download/rust-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
